{
  "id": "skill-trigger",
  "intent": "remember-type instruction triggers use_skill(memory-guidance) then remember",
  "env": {},
  "initialMemory": [],
  "opening": "I want you to remember things about me properly. My name is Alice.",
  "recording": [
    {
      "tool_calls": [
        {
          "id": "c1",
          "type": "function",
          "function": {
            "name": "use_skill",
            "arguments": "{\"name\":\"memory-guidance\"}"
          }
        }
      ]
    },
    {
      "tool_calls": [
        {
          "id": "c2",
          "type": "function",
          "function": {
            "name": "tlm_memory",
            "arguments": "{\"action\":\"remember\",\"key\":\"player_name\",\"value\":\"Alice\",\"importance\":\"core\"}"
          }
        }
      ]
    },
    { "content": "Understood. I've loaded the memory guidance and remembered that your name is Alice." }
  ],
  "assertions": {
    "toolCalls": ["use_skill", "tlm_memory"],
    "memoryHas": { "player_name": "Alice" }
  }
}
